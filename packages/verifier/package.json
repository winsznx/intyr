{
  "name": "@intyr/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks an Intyr manifest against its published key and the public Algorand record, without trusting Intyr's server",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "verify": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intyr/chain": "workspace:*",
    "@intyr/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
